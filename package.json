    "fflate": "^0.8.3",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "meshoptimizer": "^1.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
